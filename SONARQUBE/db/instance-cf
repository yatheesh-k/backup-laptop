AWSTemplateFormatVersion: '2010-09-09'
Description: A simple CloudFormation template to launch an EC2 instance

Resources:
  MyEC2Instance:
    Type: AWS::EC2::Instance
    Properties:
      InstanceType: t2.micro        # Instance type
      ImageId: ami-0c55b159cbfafe1f0  # Replace with a valid AMI ID for your region
      KeyName: my-key-pair         # Replace with the name of an existing key pair for SSH access
      SecurityGroups:
        - Ref: MySecurityGroup     # Security group reference
      Tags:
        - Key: Name
          Value: MyEC2Instance    # Tag the instance with a name

  MySecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Allow SSH and HTTP access
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: '22'
          ToPort: '22'
          CidrIp: 0.0.0.0/0     # Allow SSH access from anywhere
        - IpProtocol: tcp
          FromPort: '80'
          ToPort: '80'
          CidrIp: 0.0.0.0/0     # Allow HTTP access from anywhere

Outputs:
  InstanceId:
    Description: EC2 Instance ID
    Value: !Ref MyEC2Instance
